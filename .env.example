# Neon Postgres connection string (server-side only, never exposed to the browser)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign Owner session cookies. Generate with: openssl rand -hex 32
JWT_SECRET=

# bcrypt hash of the Owner login password (never store the plaintext password).
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
OWNER_PASSWORD_HASH=
